<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nexora.browser">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".NexoraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Nexora">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.BulkCreateActivity"
            android:exported="false"
            android:label="Bulk profile creation"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.EditProfileActivity"
            android:exported="false"
            android:label="Profile" />

        <activity
            android:name=".ui.BrowserActivity"
            android:theme="@style/Theme.Nexora.Browser"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:hardwareAccelerated="true" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="About NEXORA" />

    </application>

</manifest>
