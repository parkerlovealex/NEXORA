<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexora" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nexora_accent</item>
        <item name="colorPrimaryVariant">@color/nexora_cta</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/nexora_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/nexora_surface</item>
        <item name="colorOnSurface">@color/nexora_text</item>
        <item name="android:colorBackground">@color/nexora_bg</item>
        <item name="android:windowBackground">@color/nexora_bg</item>
        <item name="android:textColorPrimary">@color/nexora_text</item>
        <item name="android:textColorSecondary">@color/nexora_muted</item>
        <item name="android:statusBarColor">@color/nexora_header</item>
        <item name="android:navigationBarColor">@color/nexora_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="BrowserBottomIcon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/nexora_browser_text</item>
        <item name="android:soundEffectsEnabled">true</item>
    </style>

    <style name="Theme.Nexora.Browser" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nexora_accent</item>
        <item name="colorPrimaryVariant">@color/nexora_cta</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/nexora_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/nexora_browser_surface</item>
        <item name="colorOnSurface">@color/nexora_browser_text</item>
        <item name="android:colorBackground">@color/nexora_browser_bg</item>
        <item name="android:windowBackground">@color/nexora_browser_bg</item>
        <item name="android:textColorPrimary">@color/nexora_browser_text</item>
        <item name="android:textColorSecondary">@color/nexora_browser_muted</item>
        <item name="android:statusBarColor">@color/nexora_browser_bg</item>
        <item name="android:navigationBarColor">@color/nexora_browser_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
