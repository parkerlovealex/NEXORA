<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexora_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/nexora_header"
        app:title="Profile"
        app:titleTextColor="@color/nexora_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="N E X O R A   /   P R O F I L E   S T U D I O"
            android:textColor="@color/nexora_accent"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Profile setup"
            android:textColor="@color/nexora_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Choose a device, connection and browser preferences."
            android:textColor="@color/nexora_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE CONFIGURATION"
                android:textColor="@color/nexora_muted"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <!-- Identity -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/nexora_surface"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/nexora_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Identity"
                        android:textColor="@color/nexora_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Profile name"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/omnibox_bg"
                        android:hint="e.g. US Shopping 1"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/nexora_text"
                        android:textColorHint="@color/nexora_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Profile group"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etGroupName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/omnibox_bg"
                        android:hint="e.g. Research"
                        android:inputType="textCapWords"
                        android:maxLength="40"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/nexora_text"
                        android:textColorHint="@color/nexora_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Remark"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etRemark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/omnibox_bg"
                        android:gravity="top"
                        android:hint="Optional note for this profile"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="500"
                        android:maxLines="4"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="@color/nexora_text"
                        android:textColorHint="@color/nexora_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Device"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spDevice"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="2dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="@color/nexora_raised"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/nexora_line"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DEVICE PREVIEW"
                                android:textColor="@color/nexora_accent"
                                android:textSize="9sp"
                                android:letterSpacing="0.08"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDevicePreviewTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Selected device"
                                android:textColor="@color/nexora_text"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDevicePreviewMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/nexora_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Operating system"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spOs"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RAM"
                                android:textColor="@color/nexora_muted"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/spRam"
                                android:layout_width="match_parent"
                                android:layout_height="48dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Storage"
                                android:textColor="@color/nexora_muted"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/spStorage"
                                android:layout_width="match_parent"
                                android:layout_height="48dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- User agent -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/nexora_surface"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/nexora_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Browser identity"
                        android:textColor="@color/nexora_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="User-Agent mode"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spUaMode"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="User-Agent string"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etUa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/omnibox_bg"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:maxLines="4"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="@color/nexora_text"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegenUa"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="Regenerate User-Agent"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/nexora_raised"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/nexora_line"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Connection -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/nexora_surface"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/nexora_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connection"
                        android:textColor="@color/nexora_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Proxy assignment"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spSavedProxy"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageProxies"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:text="Open Proxy Manager"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/nexora_raised"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/nexora_line"
                        app:strokeWidth="1dp" />

                    <TextView
                        android:id="@+id/tvSavedProxyInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Saved credentials remain encrypted. HTTP, HTTPS and SOCKS5 use NEXORA's loopback relay; SOCKS4 remains import-only."
                        android:textColor="@color/nexora_muted"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/spProxyType"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp" />

                    <EditText
                        android:id="@+id/etProxyHost"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/omnibox_bg"
                        android:hint="Proxy host or IP"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/nexora_text"
                        android:textColorHint="@color/nexora_muted" />

                    <EditText
                        android:id="@+id/etProxyPort"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/omnibox_bg"
                        android:hint="Port"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/nexora_text"
                        android:textColorHint="@color/nexora_muted" />

                    <EditText
                        android:id="@+id/etProxyUser"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/omnibox_bg"
                        android:hint="Username (optional)"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/nexora_text"
                        android:textColorHint="@color/nexora_muted" />

                    <EditText
                        android:id="@+id/etProxyPass"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/omnibox_bg"
                        android:hint="Password (optional)"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/nexora_text"
                        android:textColorHint="@color/nexora_muted" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="HTTP, HTTPS and SOCKS5 use a loopback relay. Upstream credentials are kept encrypted at rest; SOCKS4 remains import-only."
                        android:textColor="@color/nexora_muted"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestProxy"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="Test proxy"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/nexora_raised"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/nexora_line"
                        app:strokeWidth="1dp" />

                    <TextView
                        android:id="@+id/tvProxyResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Locale -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/nexora_surface"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/nexora_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Locale"
                        android:textColor="@color/nexora_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Timezone"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spTimezone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />

                    <EditText
                        android:id="@+id/etTimezoneCustom"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/omnibox_bg"
                        android:hint="Custom IANA timezone, e.g. Asia/Tokyo"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/nexora_text"
                        android:textColorHint="@color/nexora_muted"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvTimezoneScope"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Partial JavaScript-level override: Intl timezone labels and Date.getTimezoneOffset change, but native local Date getters still use the Android device timezone."
                        android:textColor="@color/nexora_muted"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResolveLocale"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="Resolve locale through proxy"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/nexora_raised"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/nexora_line"
                        app:strokeWidth="1dp" />

                    <TextView
                        android:id="@+id/tvLocaleResolveResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/nexora_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Language mode"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spLanguageMode"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Language tag"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/omnibox_bg"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="en-US"
                        android:textColor="@color/nexora_text" />

                    <TextView
                        android:id="@+id/tvLanguageScope"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="JavaScript-level only: changes navigator.language and navigator.languages. It does not change Android locale or the HTTP Accept-Language header."
                        android:textColor="@color/nexora_muted"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fingerprint -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/nexora_surface"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/nexora_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fingerprint controls"
                        android:textColor="@color/nexora_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spWebrtc"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Restrict mode hides page-visible RTCPeerConnection constructors. It is not native network-level WebRTC leak prevention or proxy routing."
                        android:textColor="@color/nexora_muted"
                        android:textSize="11sp" />

                    <CheckBox
                        android:id="@+id/cbCanvas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Canvas noise (stable per profile)"
                        android:textColor="@color/nexora_text" />

                    <CheckBox
                        android:id="@+id/cbWebgl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="WebGL vendor and renderer override"
                        android:textColor="@color/nexora_text" />

                    <CheckBox
                        android:id="@+id/cbAudio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AudioContext noise"
                        android:textColor="@color/nexora_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Do Not Track"
                        android:textColor="@color/nexora_muted"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spDnt"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />

                    <CheckBox
                        android:id="@+id/cbHardwareAcceleration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Hardware acceleration"
                        android:textColor="@color/nexora_text" />

                    <CheckBox
                        android:id="@+id/cbBlockImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Block images (reduce data usage)"
                        android:textColor="@color/nexora_text" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/profile_field_bg"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ROADMAP · NOT ACTIVE"
                            android:textColor="@color/nexora_accent"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="WebRTC proxy routing — PLANNED · NOT ACTIVE; requires native network-stack support.&#10;Media device metadata — NOT ACTIVE; not implemented.&#10;Client Rects protection — NOT ACTIVE; not implemented.&#10;Speech synthesis protection — NOT ACTIVE; not implemented.&#10;Dedicated worker injection — NOT ACTIVE; document-start scripts do not cover worker globals.&#10;IP-based timezone and language — NOT ACTIVE; no resolver is connected.&#10;Native desktop browser engine — NOT ACTIVE; requires a separate desktop Chromium build.&#10;Native iOS browser engine — NOT ACTIVE; requires a separate iOS/WebKit app."
                            android:textColor="@color/nexora_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Canvas, WebGL and Audio controls are JavaScript-level transformations, not native Chromium patches."
                        android:textColor="@color/nexora_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Startup -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/nexora_surface"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/nexora_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Startup"
                        android:textColor="@color/nexora_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="One HTTP or HTTPS URL per line · up to 20 startup tabs"
                        android:textColor="@color/nexora_muted"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etStartupUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/omnibox_bg"
                        android:gravity="top"
                        android:hint="https://example.com"
                        android:inputType="textUri|textMultiLine"
                        android:maxLines="8"
                        android:minLines="3"
                        android:padding="12dp"
                        android:textColor="@color/nexora_text"
                        android:textColorHint="@color/nexora_muted" />

                    <TextView
                        android:id="@+id/tvStartupCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0 startup tabs"
                        android:textColor="@color/nexora_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:text="Save profile"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/nexora_cta"
        app:cornerRadius="16dp" />
</LinearLayout>
