<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexora_browser_bg"
    android:orientation="vertical">

    <!-- Retained for source compatibility; leaving the profile lives in the browser menu. -->
    <TextView
        android:id="@+id/btnExitProfile"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="Back to profiles" />

    <TextView
        android:id="@+id/tvProfileTitle"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="Active profile" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/nexora_browser_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/nexora_browser_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nexora_browser_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp">

                <ImageButton
                    android:id="@+id/btnSiteInfo"
                    android:layout_width="36dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Site security and privacy information"
                    android:padding="9dp"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/nexora_browser_accent" />

                <EditText
                    android:id="@+id/etOmnibox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search or enter address"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/nexora_browser_text"
                    android:textColorHint="@color/nexora_browser_muted"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btnReload"
                    android:layout_width="36dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Reload page"
                    android:padding="9dp"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/nexora_browser_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btnTabs"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/tab_counter_bg"
            android:contentDescription="Open tabs"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/nexora_browser_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNewTab"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="New tab"
            android:padding="10dp"
            android:src="@drawable/ic_plus"
            android:tint="@color/nexora_browser_text" />

        <ImageButton
            android:id="@+id/btnOverflow"
            android:layout_width="38dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Browser menu"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            android:tint="@color/nexora_browser_text" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/nexora_browser_accent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/nexora_browser_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/nexora_browser_header"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/BrowserBottomIcon"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/btnForward"
            style="@style/BrowserBottomIcon"
            android:contentDescription="Forward"
            android:src="@drawable/ic_forward" />

        <ImageButton
            android:id="@+id/btnHome"
            style="@style/BrowserBottomIcon"
            android:contentDescription="Home"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/btnBookmarks"
            style="@style/BrowserBottomIcon"
            android:contentDescription="Bookmarks"
            android:src="@drawable/ic_bookmark" />

        <ImageButton
            android:id="@+id/btnDownloads"
            style="@style/BrowserBottomIcon"
            android:contentDescription="Downloads"
            android:src="@drawable/ic_download" />
    </LinearLayout>
</LinearLayout>
