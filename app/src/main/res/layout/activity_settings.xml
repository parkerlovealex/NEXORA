<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexora_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/nexora_header"
        app:title="Settings"
        app:titleTextColor="@color/nexora_text" />

<ScrollView
    android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
    android:background="@color/nexora_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PREFERENCES"
            android:textColor="@color/nexora_muted"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/nexora_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nexora_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appearance"
                    android:textColor="@color/nexora_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbSystem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="System default"
                        android:textColor="@color/nexora_text" />

                    <RadioButton
                        android:id="@+id/rbLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Light"
                        android:textColor="@color/nexora_text" />

                    <RadioButton
                        android:id="@+id/rbDark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dark"
                        android:textColor="@color/nexora_text" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nexora_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nexora_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interaction &amp; notifications"
                    android:textColor="@color/nexora_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Choose how NEXORA responds to taps and completed downloads. Android system sound and vibration settings still apply."
                    android:textColor="@color/nexora_muted"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSoundEffects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Touch sounds"
                    android:textColor="@color/nexora_text" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHapticFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Touch vibration"
                    android:textColor="@color/nexora_text" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDownloadNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Download notifications"
                    android:textColor="@color/nexora_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Notification permission is requested only when needed. Downloads continue even if alerts are denied."
                    android:textColor="@color/nexora_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nexora_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nexora_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textColor="@color/nexora_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgSearchEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbDuckDuckGo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DuckDuckGo"
                        android:textColor="@color/nexora_text" />

                    <RadioButton
                        android:id="@+id/rbGoogle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Google"
                        android:textColor="@color/nexora_text" />

                    <RadioButton
                        android:id="@+id/rbBing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bing"
                        android:textColor="@color/nexora_text" />

                    <RadioButton
                        android:id="@+id/rbBrave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Brave Search"
                        android:textColor="@color/nexora_text" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nexora_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nexora_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEXORA catalog sync"
                    android:textColor="@color/nexora_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Connect to your deployed NEXORA website API. The bundled catalog remains available offline."
                    android:textColor="@color/nexora_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etCatalogApiBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="https://your-nexora-domain.com"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="@color/nexora_text"
                    android:textColorHint="@color/nexora_muted"
                    android:backgroundTint="@color/nexora_line"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/tvDataVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Catalog version: bundled"
                    android:textColor="@color/nexora_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnUpdateData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Check for catalog updates" />

                <Button
                    android:id="@+id/btnRollbackData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Restore previous catalog" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nexora_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nexora_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile backup &amp; restore"
                    android:textColor="@color/nexora_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Create a password-encrypted portable backup of profile configuration and saved proxy entries. Website data and browsing history are excluded."
                    android:textColor="@color/nexora_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnBackupRestore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Open Backup &amp; Restore" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nexora_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/nexora_line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browser behavior"
                    android:textColor="@color/nexora_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingsNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_note"
                    android:textColor="@color/nexora_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
</LinearLayout>
