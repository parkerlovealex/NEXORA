{"$defs":{"artifact":{"additionalProperties":false,"properties":{"dataVersion":{"pattern":"^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$","type":"string"},"file":{"pattern":"\\.json$","type":"string"},"schemaVersion":{"minimum":1,"type":"integer"},"sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"sizeBytes":{"minimum":0,"type":"integer"}},"required":["dataVersion","schemaVersion","file","sha256","sizeBytes"],"type":"object"}},"$id":"https://nexorauser.vercel.app/catalog/manifest.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"One manifest describes one complete, consistent catalog release: the shared catalogReleaseId, a monotonic releaseSequence, and every artifact's own dataVersion, schemaVersion, file name, SHA-256 hash and byte size. Signing fields arrive in Phase 4.4; until signing.status is 'signed', the manifest is a release contract, not a trust anchor.","properties":{"artifacts":{"additionalProperties":false,"properties":{"desktop":{"$ref":"#/$defs/artifact"},"devices":{"$ref":"#/$defs/artifact"},"uaTemplates":{"$ref":"#/$defs/artifact"}},"required":["devices","uaTemplates","desktop"],"type":"object"},"catalogReleaseId":{"pattern":"^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$","type":"string"},"releaseSequence":{"minimum":1,"type":"integer"},"schemaVersion":{"const":1},"signing":{"additionalProperties":false,"properties":{"algorithm":{"type":["string","null"]},"keyId":{"type":["string","null"]},"note":{"type":"string"},"signature":{"type":["string","null"]},"status":{"enum":["unsigned","signed"]}},"required":["status","algorithm","keyId","signature","note"],"type":"object"}},"required":["schemaVersion","catalogReleaseId","releaseSequence","artifacts","signing"],"title":"NEXORA Catalog Release Manifest","type":"object"}