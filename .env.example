# Database: use PostgreSQL for production. SQLite is used automatically if omitted.
DATABASE_URL=sqlite:///./nexora-dev.db  # Docker Compose overrides this with PostgreSQL
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Required before enabling administrator login. Use a long random value.
NEXORA_ADMIN_PASSWORD=replace-with-a-long-unique-password
NEXORA_SECRET_KEY=replace-with-at-least-32-random-characters

# Optional OpenAI-compatible AI provider. Never expose these in frontend config.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Public frontend origins, comma-separated. Example: https://nexora.example.com
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Optional background worker settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
